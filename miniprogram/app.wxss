page {
  --paper: #f5f7fc;
  --surface: #ffffff;
  --surface-soft: #f0f4fb;
  --ink: #18243a;
  --muted: #68778e;
  --line: #e1e7f0;
  --blue: #245dd7;
  --blue-deep: #1c49b6;
  --blue-light: #eaf0ff;
  --teal: #087f78;
  --teal-light: #e4f5f1;
  --red: #c43d52;
  --red-light: #fff0f2;
  --shadow: 0 8px 24px rgba(29, 48, 82, 0.06);
  background: var(--paper);
  color: var(--ink);
  font-family: "PingFang SC", "Microsoft YaHei", sans-serif;
  font-size: 16px;
  line-height: 1.5;
}

view, button, text { box-sizing: border-box; }
button {
  font: inherit;
  color: inherit;
  transition: opacity 160ms ease, transform 160ms ease, box-shadow 160ms ease;
}
button::after { border: 0; }
button[disabled] { opacity: 0.46; box-shadow: none; }
.page {
  max-width: 552px;
  margin: 0 auto;
  padding: 24px 16px calc(28px + env(safe-area-inset-bottom));
}
.title { font-size: 28px; font-weight: 700; line-height: 1.3; letter-spacing: 0.2px; }
.subtitle { color: var(--muted); font-size: 14px; line-height: 1.7; }
.row { display: flex; align-items: center; justify-content: space-between; }
.section-label { margin: 24px 0 12px; font-size: 15px; font-weight: 600; }
.muted { color: var(--muted); }
.numbers { font-variant-numeric: tabular-nums; font-family: Arial, "PingFang SC", sans-serif; }

.primary, .secondary, .text-button {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 50px;
  margin: 0;
  padding: 13px 20px;
  border-radius: 14px;
  line-height: 1.4;
  font-weight: 600;
}
.primary {
  background: linear-gradient(135deg, var(--blue-deep), #4776e6);
  color: #ffffff;
  box-shadow: 0 8px 18px rgba(36, 93, 215, 0.2);
}
.secondary { background: var(--surface); border: 1px solid var(--line); box-shadow: 0 3px 10px rgba(29, 48, 82, 0.04); }
.text-button { min-height: 44px; padding: 10px 8px; background: transparent; color: var(--blue); font-size: 14px; font-weight: 500; }
.pressed { opacity: 0.78; transform: scale(0.985); }

.chips { display: flex; flex-wrap: wrap; justify-content: center; margin: -5px; }
.chip {
  display: flex;
  align-items: center;
  justify-content: center;
  width: calc(33.333% - 10px);
  aspect-ratio: 1 / 1;
  min-height: 48px;
  margin: 5px;
  padding: 10px 6px;
  background: var(--surface);
  border: 1px solid var(--line);
  border-radius: 12px;
  box-shadow: 0 3px 10px rgba(29, 48, 82, 0.03);
  font-size: 17px;
  font-weight: 650;
  line-height: 1.3;
}
.chip.selected {
  padding: 10px 6px;
  background: var(--blue-light);
  color: var(--blue);
  border: 1px solid var(--blue);
  box-shadow: 0 4px 12px rgba(36, 93, 215, 0.1);
  font-weight: 650;
}
.rule {
  margin: 18px 0 20px;
  padding: 14px 16px;
  background: var(--surface);
  border: 1px solid var(--line);
  border-radius: 14px;
  color: var(--muted);
  font-size: 14px;
  line-height: 1.8;
}
.start-button {
  width: 100%;
  min-height: 64px;
  padding-left: 24px;
  border-radius: 18px;
  font-size: 22px;
  letter-spacing: 4px;
}
.prepare-footnote { margin-top: 16px; color: var(--muted); font-size: 12px; line-height: 1.8; text-align: center; }
.notice {
  margin: 14px 0;
  padding: 13px 15px;
  background: var(--blue-light);
  border: 1px solid #d8e4ff;
  border-radius: 12px;
  color: var(--ink);
  font-size: 14px;
  line-height: 1.6;
}
.error-notice { background: var(--red-light); border-color: #f6d6dc; color: var(--red); }

.play-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  min-height: 68px;
  margin: 0 0 14px;
  padding: 10px 12px;
  background: var(--surface);
  border: 1px solid var(--line);
  border-radius: 16px;
  box-shadow: var(--shadow);
}
.play-hint { color: var(--muted); font-size: 13px; }
.play-target { margin-left: 5px; color: var(--blue); font-size: 22px; font-weight: 650; }
.play-clock { padding: 6px 10px; background: var(--blue-light); border-radius: 10px; font-size: 22px; font-weight: 650; white-space: nowrap; }
.play-clock text { margin-left: 4px; color: var(--muted); font-size: 11px; font-weight: 400; }
.play-footer { display: flex; align-items: center; justify-content: space-between; margin: 16px 2px 0; color: var(--muted); font-size: 13px; }
.end-row { display: flex; justify-content: center; margin-top: 14px; }
.end-row .text-button { color: var(--muted); }
.progress-track { height: 6px; overflow: hidden; background: #e5eaf3; border-radius: 3px; }
.progress-fill { height: 6px; background: linear-gradient(90deg, var(--blue), #5a86eb); border-radius: 3px; }

.empty {
  margin-top: 16px;
  padding: 48px 20px;
  background: var(--surface);
  border: 1px solid var(--line);
  border-radius: 20px;
  box-shadow: var(--shadow);
  text-align: center;
}
.empty-title { margin-bottom: 10px; font-size: 20px; font-weight: 650; }
.empty .primary { min-width: 160px; margin: 24px auto 0; }

@media (max-width: 350px) {
  .page { padding-top: 18px; }
  .title { font-size: 26px; }
  .play-header { padding: 9px 10px; }
  .play-target, .play-clock { font-size: 20px; }
  .start-button { font-size: 20px; }
}
@media (max-height: 700px) {
  .page { padding-top: 18px; }
  .section-label { margin-top: 20px; }
  .rule { margin-top: 14px; margin-bottom: 16px; }
  .start-button { min-height: 58px; }
  .prepare-footnote { margin-top: 14px; }
}
@media (prefers-reduced-motion: reduce) {
  view, button { animation: none; transition: none; }
}
