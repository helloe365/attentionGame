.prepare-subtitle { margin-top: 8px; }
.schulte-page .spec-chip { font-size: 19px; }
.fixed-spec { margin-left: 10px; padding: 2px 7px; background: var(--surface-soft); border-radius: 7px; color: var(--muted); font-size: 12px; font-weight: 400; }
.schulte-page.playing {
  display: flex;
  flex-direction: column;
  min-height: 100vh;
  padding-left: 4px;
  padding-right: 4px;
}
.board-stage {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}
.board {
  display: flex;
  flex-wrap: wrap;
  flex-shrink: 0;
  margin: 0 auto;
  overflow: hidden;
  background: var(--surface);
  border-radius: 14px;
  box-shadow: 0 0 0 1px var(--line), 0 12px 28px rgba(29, 48, 82, 0.07);
}
.grid-cell {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  margin: 0;
  padding: 0;
  background: var(--surface);
  border: 0.5px solid #e4e9f1;
  border-radius: 0;
  color: var(--ink);
  font-weight: 500;
  line-height: 1;
}
.grid-cell.dimmed { background: #edf1f6; color: #8996a8; }
.grid-cell.correct { background: var(--blue-light); box-shadow: inset 0 0 0 1px rgba(36, 93, 215, 0.18); }
.grid-cell.wrong { background: var(--red); color: #ffffff; }
.tile-pressed { background: #dce7ff; }
.letter-board { background: transparent; border-radius: 0; box-shadow: none; }
.equation {
  flex-shrink: 0;
  width: 100%;
  min-height: 76px;
  margin: 0 0 16px;
  padding: 16px 8px;
  background: linear-gradient(135deg, #eaf0ff, #f3f6ff);
  border: 1px solid #dbe6ff;
  border-radius: 16px;
  font-size: 26px;
  font-weight: 600;
  line-height: 1.5;
  text-align: center;
}
.error-count { color: var(--red); }
