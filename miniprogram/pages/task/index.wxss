.task-subtitle { margin-top: 8px; }
.task-preview {
  min-height: 172px;
  margin: 24px 0 18px;
  padding: 24px 16px 18px;
  background: linear-gradient(145deg, #ffffff, #f8faff);
  border: 1px solid var(--line);
  border-radius: 20px;
  box-shadow: var(--shadow);
  text-align: center;
}
.preview-word { color: var(--blue); font-size: 56px; font-weight: 600; line-height: 1.2; }
.preview-arrows { font-size: 28px; font-weight: 600; line-height: 68px; white-space: nowrap; }
.preview-caption { margin-top: 16px; color: var(--muted); font-size: 13px; line-height: 1.6; }
.preview-shapes { display: flex; justify-content: center; align-items: center; height: 68px; gap: 36px; }
.shape { flex-shrink: 0; width: 60px; height: 60px; background: var(--ink); }
.circle { border-radius: 50%; }
.square { border-radius: 8px; }
.shape.blue { background: #245dd7; }
.shape.orange { background: #c46b00; }
.standard-label { display: inline-block; padding: 4px 10px; background: var(--teal-light); border-radius: 8px; color: var(--teal); font-size: 12px; font-weight: 600; }
.rule { margin-top: 14px; }
.stimulus-stage {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 248px;
  margin: 14px 0 16px;
  background: var(--surface);
  border: 1px solid var(--line);
  border-radius: 20px;
  box-shadow: var(--shadow);
}
.stimulus-word { font-size: 84px; font-weight: 650; line-height: 1.2; }
.stimulus-arrows { font-size: 34px; font-weight: 600; line-height: 1.2; white-space: nowrap; }
.stimulus-shape { position: absolute; width: 74px; height: 74px; }
.stimulus-shape.left { left: 12%; }
.stimulus-shape.right { right: 12%; }
.fixation { color: #8290a4; font-size: 28px; }
.response-buttons { display: flex; flex-wrap: wrap; justify-content: space-between; }
.response-button {
  display: flex;
  justify-content: center;
  align-items: center;
  width: calc(50% - 6px);
  min-height: 70px;
  margin: 0 0 12px;
  padding: 14px 8px;
  border: 1px solid;
  border-radius: 16px;
  box-shadow: 0 4px 12px rgba(29, 48, 82, 0.05);
  font-size: 20px;
  font-weight: 600;
  line-height: 1.4;
}
.four-buttons .response-button { min-height: 62px; }
.one-button .response-button { width: 100%; min-height: 76px; }

@media (max-width: 350px) {
  .stimulus-word { font-size: 72px; }
  .stimulus-arrows, .preview-arrows { font-size: 27px; }
  .stimulus-shape.left { left: 9%; }
  .stimulus-shape.right { right: 9%; }
}
@media (max-height: 650px) {
  .stimulus-stage { height: 200px; }
  .response-button { min-height: 60px; }
}
