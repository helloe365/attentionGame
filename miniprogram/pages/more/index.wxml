<view class="page">
  <view class="title">换一种专注方式</view>
  <view class="subtitle intro">从辨认颜色，到跟住移动的目标。</view>
  <button wx:for="{{games}}" wx:key="id" class="game-card" hover-class="pressed"
    data-game="{{item.id}}" bindtap="onGameTap" aria-label="{{item.name}}，{{item.short}}">
    <view class="game-mark {{item.id}}" aria-hidden="true">
      <image class="game-icon" src="/assets/images/icons/task-{{item.id}}.png" mode="aspectFit" />
    </view>
    <view class="game-copy">
      <view class="game-name"><text>{{item.name}}</text><text wx:if="{{item.englishName}}" class="game-english">{{item.englishName}}</text></view>
      <view class="subtitle">{{item.short}}</view>
    </view>
  </button>
</view>
