.intro { margin: 8px 0 24px; }
.game-card {
  position: relative;
  display: flex;
  align-items: center;
  width: 100%;
  min-height: 108px;
  margin: 0 0 12px;
  padding: 18px 14px;
  background: var(--surface);
  border: 1px solid var(--line);
  border-radius: 18px;
  box-shadow: var(--shadow);
  text-align: left;
}
.game-mark {
  flex-shrink: 0;
  width: 52px;
  height: 52px;
  margin-right: 14px;
  padding: 2px;
  overflow: hidden;
  background: var(--surface);
  border: 1px solid var(--line);
  border-radius: 16px;
  box-shadow: 0 3px 8px rgba(29, 48, 82, 0.04);
}
.game-icon { display: block; width: 100%; height: 100%; border-radius: 13px; }
.game-copy { flex: 1; min-width: 0; }
.game-name { display: flex; align-items: baseline; gap: 8px; margin-bottom: 6px; font-size: 18px; font-weight: 650; }
.game-english { color: var(--muted); font-size: 13px; font-weight: 500; line-height: 1.4; white-space: nowrap; }
.game-copy .subtitle { font-size: 12px; line-height: 1.6; }

@media (max-width: 350px) {
  .game-card { padding: 16px 12px; }
  .game-mark { width: 46px; height: 46px; margin-right: 12px; border-radius: 14px; }
  .game-name { font-size: 17px; }
}
